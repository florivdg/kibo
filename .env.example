# Database (PostgreSQL, see docker-compose.yml)
POSTGRES_USER=kibo
POSTGRES_PASSWORD=kibo_dev_password
POSTGRES_DB=kibo
DATABASE_URL=postgresql://kibo:kibo_dev_password@localhost:5432/kibo

# Better Auth
BETTER_AUTH_URL=http://localhost:4321
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Reverse proxies vor Kibo, als IP oder CIDR, kommasepariert. Leer lassen,
# solange nur ein Proxy davor steht. Siehe docs/selbst-hosten/spam-schutz.md.
TRUSTED_PROXIES=

# Who may sign up. open: anyone (the default). closed: nobody — accounts are
# created with `bun run admin create-user --email … --name …`.
SIGNUP_MODE=open
# Mail domains an account may have, comma-separated; empty allows any. `*.` in
# front covers the subdomains, not the domain itself:
#   SIGNUP_EMAIL_DOMAINS=kita-verbund.de, *.kita-verbund.de
SIGNUP_EMAIL_DOMAINS=

# true only on the project's hosted instance (subscriptions, terms, /docs);
# its settings below stay empty when self-hosting, but are always checked.
# The admin area's "Hilfe" link opens DOCS_URL — empty means the docs folder
# on GitHub.
HOSTED=false
DOCS_URL=
HOSTED_PRICE_EUR=
HOSTED_INCLUDED_KITAS=
HOSTED_EXTRA_KITA_EUR=
HOSTED_TRIAL_DAYS=
HOSTED_TERMS_VERSION=
HOSTED_OPERATOR_EMAIL=
HOSTED_PRICE_NOTE=
PLAUSIBLE_DOMAIN=
PLAUSIBLE_URL=

# Where "Quelltext" in the footer of every page leads. Empty: Kibo's
# repository. Kibo is AGPL: whoever runs a changed version for others points
# this at the source of that version (§ 13).
SOURCE_URL=

# Mail (SMTP). Without SMTP_HOST, the dev server writes mails to its log
# instead of sending them — the confirmation and reset links stay usable.
# A production build refuses to send instead of logging the links.
#
# For a real postbox locally, start Mailpit with
#   docker compose --profile mail up -d
# and use the two lines below; read the mails on http://localhost:8025.
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
#   SMTP_ALLOW_INSECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Kibo <kibo@example.org>"
# Implicit TLS. Empty means "only on port 465".
SMTP_SECURE=
# Only for Mailpit: allows an unencrypted SMTP session. Everything else
# requires STARTTLS and a valid certificate.
SMTP_ALLOW_INSECURE=false

# Imprint and privacy policy: either external addresses (complete, with
# https:// — every mail links them) …
IMPRESSUM_URL=
DATENSCHUTZ_URL=
# … or Markdown files impressum.md / datenschutz.md in this directory
LEGAL_DIR=./legal

# Who runs the instance, named in the footer of every mail; the footer shows
# what is set and the start-up log warns about the rest. Lines are separated
# by |:
#   OPERATOR_ADDRESS="Musterstraße 1 | 12345 Musterstadt"
#   OPERATOR_LEGAL_INFO="Amtsgericht Musterstadt, HRB 12345 | USt-IdNr.: DE123456789"
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
OPERATOR_LEGAL_INFO=
# Hosted mode only
AGB_URL=
AVV_URL=

# Web push for new notes (optional, all three or none). Generate the keys with
#   bunx @pushforge/builder vapid
# and paste the JWK line in single quotes. Empty: no bell on the boards.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
