# Kibo – Beispielkonfiguration für den Betrieb hinter Traefik.
# Kopieren nach .env, ausfüllen, niemals ins Git einchecken.

# --- Domain und Image --------------------------------------------------------
# Öffentliche Adresse dieser Instanz (ohne Protokoll)
KIBO_DOMAIN=kibo.example.org
# Optional: eine zweite Domain, die auf KIBO_DOMAIN weiterleitet (etwa die
# Domain ohne www). Beide Zeilen einkommentieren, beide Namen brauchen einen
# DNS-Eintrag. Erklärt in docs/selbst-hosten/traefik.md, „Zweite Domain“.
# KIBO_REDIRECT_DOMAIN=example.org
# COMPOSE_FILE=compose.yml:compose.redirect.yml
# Image-Version, fest genagelt – App, Migration und Lasttest-Helfer nutzen
# denselben Wert.
# Für ein Update die neue Version aus CHANGELOG.md bzw. den GitHub-Releases
# hier eintragen und ./update.sh ausführen (docs/selbst-hosten/updates.md).
KIBO_IMAGE_TAG=1.2.1

# --- Vorhandener Traefik -----------------------------------------------------
# Docker-Netzwerk, das Kibo mit Traefik teilt (docker network create proxy).
# Empfohlen: ein eigenes Netz nur für Traefik und Kibo, z. B. kibo-proxy –
# jeder andere Container im selben Netz erreicht die App direkt am Proxy
# vorbei. Siehe docs/selbst-hosten/sicherheit.md, „Proxy-Netzwerk“.
KIBO_PROXY_NETWORK=proxy
# Namen aus der Traefik-Konfiguration; die Vorgaben passen zum Beispiel
# in deploy/traefik/
KIBO_ENTRYPOINT=websecure
KIBO_CERTRESOLVER=letsencrypt

# --- Anwendung ---------------------------------------------------------------
# Pflicht. Muss exakt die öffentliche Adresse mit https:// sein: Cookies,
# Auth-Links, Links zu den Brettern und QR-Codes werden daraus gebildet.
BETTER_AUTH_URL=https://kibo.example.org
# Pflicht, mindestens 32 Zeichen: openssl rand -base64 32
# Stabil halten: ein neuer Wert macht alle Sitzungen und offenen
# Bestätigungs- und Reset-Links ungültig.
BETTER_AUTH_SECRET=

# Reverse Proxys vor Kibo, als IP oder CIDR, kommasepariert. Leer lassen, wenn
# Traefik der einzige Proxy ist; mit CDN davor dessen Bereiche eintragen. Ein
# ungültiger Eintrag lässt die App nicht starten.
# Erklärt in docs/selbst-hosten/spam-schutz.md, „Vertrauensgrenze“.
TRUSTED_PROXIES=

# --- Registrierung -----------------------------------------------------------
# open (Vorgabe): Jede und jeder kann unter /admin/signup ein Konto anlegen.
# closed: Niemand registriert sich selbst; Konten legt der Betrieb an:
#   docker compose exec app node dist/admin.mjs create-user --email … --name …
# Siehe docs/selbst-hosten/konfiguration.md.
SIGNUP_MODE=open
# Erlaubte E-Mail-Domains für neue Konten und geänderte Adressen,
# kommasepariert. Leer = keine Einschränkung. *.domain erfasst alle
# Subdomains, aber nicht die Domain selbst – wer beides will, nennt beides:
#   SIGNUP_EMAIL_DOMAINS=kita-verbund.de, *.kita-verbund.de
# Ein ungültiger Wert in einer der beiden Variablen lässt die App nicht
# starten.
SIGNUP_EMAIL_DOMAINS=

# --- Dokumentation -----------------------------------------------------------
# Wohin „Hilfe“ im Admin-Bereich führt. Leer = die Dokumentation im
# Repository auf GitHub; wer seinen Kitas eine eigene Anleitung gibt, trägt
# deren Adresse ein (mit https://).
DOCS_URL=
# Modus der gehosteten Instanz des Projekts. Selbst gehostet bleibt es bei
# false. Siehe docs/selbst-hosten/konfiguration.md, „Gehosteter Modus“.
HOSTED=false

# --- Quelltext ---------------------------------------------------------------
# Wohin „Quelltext“ am Fuß jeder Seite führt. Leer = das Repository von Kibo.
# Kibo steht unter der AGPL: Wer eine geänderte Fassung betreibt, trägt hier
# die Adresse ihres Quelltexts ein (mit https://), siehe
# docs/selbst-hosten/konfiguration.md, „Quelltext-Link“.
SOURCE_URL=

# --- Datenbank ---------------------------------------------------------------
POSTGRES_USER=kibo
# openssl rand -hex 24 – hexadezimal, weil / + = aus base64 die DATABASE_URL
# unten zerbrechen würden
POSTGRES_PASSWORD=
POSTGRES_DB=kibo
# Host ist der Servicename aus compose.yml, nicht localhost
DATABASE_URL=postgresql://kibo:DASSELBE_PASSWORT@postgres:5432/kibo

# --- E-Mail (SMTP) -----------------------------------------------------------
# Ohne SMTP_HOST versendet Kibo nichts: Registrierung und Passwort-Reset
# funktionieren dann nicht. Das Log weist beim Start darauf hin.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Absender; die Domain sollte per SPF/DKIM zum Postausgangsserver passen
SMTP_FROM="Kibo <kibo@example.org>"
# Leer lassen: Port 465 nutzt implizites TLS, alles andere verlangt STARTTLS.
# true/false überschreibt das.
SMTP_SECURE=
# Nur für lokale Tests mit Mailpit: erlaubt unverschlüsselten Versand.
SMTP_ALLOW_INSECURE=false

# --- Impressum und Datenschutz -----------------------------------------------
# Entweder hier auf die eigene Website verweisen (vollständige Adresse mit
# https://, denn jede E-Mail verlinkt sie) …
IMPRESSUM_URL=
DATENSCHUTZ_URL=
# … oder deploy/legal/impressum.md und deploy/legal/datenschutz.md ausfüllen.
# Das Verzeichnis ./legal wird schreibgeschützt eingebunden.

# --- Betreiberangaben im Fuß jeder E-Mail -----------------------------------
# Wer die Instanz betreibt. Der Fuß nennt nur, was gesetzt ist; fehlt etwas,
# warnt das Log beim Start. Zeilen der Anschrift und der Pflichtangaben trennt ein |, zum Beispiel
#   OPERATOR_ADDRESS="Musterstraße 1 | 12345 Musterstadt"
#   OPERATOR_LEGAL_INFO="Amtsgericht Musterstadt, HRB 12345 | Geschäftsführung: Anna Beispiel | USt-IdNr.: DE123456789"
# Name und Anschrift ohne Links.
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
# Was die Rechtsform in Geschäftsbriefen verlangt: Rechtsform, Sitz,
# Registergericht und -nummer, Vertretungsberechtigte, USt-IdNr. …
OPERATOR_LEGAL_INFO=

# --- Benachrichtigungen (Web-Push) -------------------------------------------
# Optional: alle drei oder keine. Leer = keine Glocke auf den Brettern.
# Erzeugen mit `bunx @pushforge/builder vapid`, ohne Bun auf dem Server:
# `docker run --rm oven/bun:1 bunx @pushforge/builder vapid`
# (docs/selbst-hosten/benachrichtigungen.md). Die JSON-Zeile in einfachen
# Anführungszeichen eintragen.
# Stabil halten: neue Schlüssel machen alle bestehenden Abos wertlos.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt für die Push-Dienste: mailto:… oder https://…
VAPID_SUBJECT=

# --- Optionale Lasttest-Daten ------------------------------------------------
# Nur für ausdrücklich gestartete `docker compose run --rm load-fixtures`.
# Vorgabe staging; auf der Produktion vor Provision/Cleanup bewusst auf
# production setzen. Keine Wirkung auf die App oder normale Stack-Starts.
# DATABASE_URL, BETTER_AUTH_URL und HOSTED werden automatisch wiederverwendet.
KIBO_LOAD_ENVIRONMENT=staging
