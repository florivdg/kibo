---
import type { MarkdownHeading } from 'astro'

import DocsPager from '@/components/docs/DocsPager.astro'
import DocsSidebar from '@/components/docs/DocsSidebar.astro'
import DocsToc from '@/components/docs/DocsToc.astro'
import { FOCUS_RING } from '@/components/docs/focus-ring'
import FrontendLayout from '@/layouts/Frontend.astro'
import { DOCS_INDEX_ID, docLink, docsPath } from '@/lib/docs/navigation'
import { neighbours } from '@/lib/docs/pages'
import { docTitles } from '@/lib/docs/titles'

// The shell of the documentation under /docs: the pages of both sections on
// the left, the text as a sheet of paper on the felt, the page's own headings
// on the right. Narrow screens get both lists as <details> above the text, so
// nothing here needs a script.
interface Props {
  id: string
  description?: string
  headings: MarkdownHeading[]
}

const { id, description, headings } = Astro.props

// No frontmatter in docs/: a page's title is its own first heading
const titles = await docTitles()
const { title } = docLink(id, titles)

const SITE_TITLE = 'Kibo-Dokumentation'
const pageTitle = id === DOCS_INDEX_ID ? title : `${title} – ${SITE_TITLE}`

// A single heading is no table of contents
const toc = headings.filter(({ depth }) => depth === 2 || depth === 3)
const hasToc = toc.length > 1

const pageLink = (target: string | undefined) =>
  target === undefined ? undefined : docLink(target, titles)
const { previous, next } = neighbours(id)

const summaryClass = `border-tinte/20 hover:bg-tinte/5 cursor-pointer rounded-full border-2 px-4 py-2 font-semibold ${FOCUS_RING}`
const stickyClass = 'sticky top-6 max-h-[calc(100svh-3rem)] overflow-y-auto'
---

<FrontendLayout
  title={pageTitle}
  description={description}
  canonical={docsPath(id)}
>
  <a
    href="#inhalt"
    class:list={[
      'text-tinte sr-only rounded-full bg-white px-4 py-2 font-bold focus:not-sr-only focus:absolute focus:top-3 focus:left-3',
      FOCUS_RING,
    ]}
  >
    Zum Inhalt springen
  </a>
  <header class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 pt-6 sm:px-6 sm:pt-8">
    <a href="/" class:list={['rounded-md', FOCUS_RING]}>
      <img
        src="/logo.svg"
        alt="Kibo – zur Startseite"
        width="224"
        height="64"
        class="h-8 w-auto sm:h-9"
      />
    </a>
    <a
      href="/docs"
      class:list={['font-display rounded-md text-xl sm:text-2xl', FOCUS_RING]}
    >
      Dokumentation
    </a>
  </header>
  <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-5 px-4 pt-6 pb-16 sm:px-6 sm:pt-8 lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-8 xl:grid-cols-[16rem_minmax(0,1fr)_14rem]">
    <details class="lg:hidden">
      <summary class={summaryClass}>Alle Seiten</summary>
      <div class="pt-3">
        <DocsSidebar titles={titles} currentId={id} />
      </div>
    </details>
    <aside class="hidden lg:block">
      <div class={stickyClass}>
        <DocsSidebar titles={titles} currentId={id} />
      </div>
    </aside>
    <main id="inhalt" class="min-w-0">
      {hasToc && (
        <details class="mb-5 xl:hidden">
          <summary class={summaryClass}>Auf dieser Seite</summary>
          <div class="px-4 pt-3">
            <DocsToc headings={toc} />
          </div>
        </details>
      )}
      <article class="note-paper bg-white/80 px-5 py-8 text-lg [--prose-tint:rgb(34_48_74/0.07)] sm:px-10 sm:py-10">
        <div class="markdown-prose">
          <slot />
        </div>
        <DocsPager previous={pageLink(previous)} next={pageLink(next)} />
      </article>
    </main>
    {hasToc && (
      <aside class="hidden xl:block">
        <div class={stickyClass}>
          <p class="mb-2 text-sm font-bold tracking-wide uppercase">
            Auf dieser Seite
          </p>
          <DocsToc headings={toc} />
        </div>
      </aside>
    )}
  </div>
</FrontendLayout>
