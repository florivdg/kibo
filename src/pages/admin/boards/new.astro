---
import CreateBoardForm from '@/components/admin/boards/CreateBoardForm.vue'
import AdminLayout from '@/layouts/Admin.astro'
import { countBoards } from '@/lib/board/queries'
import { BOARD_LIMIT } from '@/lib/limits'

// A Kita the hosted instance has paused takes no new boards, nor one that
// has BOARD_LIMIT; the list says why (the notice in the layout, the sentence
// in place of the button)
const organizationId = Astro.locals.organizationId!
if (
  Astro.locals.kitaPaused ||
  (await countBoards(organizationId)) >= BOARD_LIMIT
) {
  return Astro.redirect('/admin/boards')
}
---

<AdminLayout
  title="Brett anlegen"
  breadcrumbs={[
    { label: 'Bretter', href: '/admin/boards' },
    { label: 'Brett anlegen' },
  ]}
>
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight">Brett anlegen</h1>
      <p class="mt-1 text-muted-foreground">
        Nach dem Anlegen erhalten Sie den Link zum Teilen.
      </p>
    </div>
    <CreateBoardForm client:load />
  </div>
</AdminLayout>
