---
import { Plus } from '@lucide/vue'

import { buttonVariants } from '@/components/ui/button'
import {
  Card,
  CardDescription,
  CardHeader,
  CardTitle,
} from '@/components/ui/card'
import AdminLayout from '@/layouts/Admin.astro'
import { listBoards } from '@/lib/board/queries'

// The middleware guarantees an active Kita on admin pages
const organizationId = Astro.locals.organizationId!
const boards = await listBoards(organizationId, new Date())
// A Kita the hosted instance has paused takes no new boards
const paused = Astro.locals.kitaPaused

const busiest = boards.toSorted((a, b) => b.noteCount - a.noteCount)[0]
const stats = [
  { label: 'Bretter', value: boards.length },
  {
    label: 'Zettel, die gerade hängen',
    value: boards.reduce((sum, board) => sum + board.noteCount, 0),
  },
  {
    label: 'Meiste Zettel',
    value: busiest?.noteCount ? busiest.name : '–',
  },
]
---

<AdminLayout title="Dashboard" breadcrumbs={[{ label: 'Dashboard' }]}>
  <div class="space-y-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight">Dashboard</h1>
        <p class="mt-1 text-muted-foreground">
          Überblick über die Bretter Ihrer Kita.
        </p>
      </div>
      {!paused && (
        <a
          href="/admin/boards/new"
          class={buttonVariants({
            variant: boards.length ? 'outline' : 'default',
          })}
        >
          <Plus /> Brett anlegen
        </a>
      )}
    </div>
    <div class="grid gap-4 sm:grid-cols-3">
      {stats.map((stat) => (
        <Card>
          <CardHeader>
            <CardDescription>{stat.label}</CardDescription>
            <CardTitle class="truncate text-3xl tabular-nums">
              {stat.value}
            </CardTitle>
          </CardHeader>
        </Card>
      ))}
    </div>
    {boards.length > 0 && (
      <p>
        <a href="/admin/boards" class="text-sm underline underline-offset-4">
          Alle Bretter verwalten
        </a>
      </p>
    )}
  </div>
</AdminLayout>
