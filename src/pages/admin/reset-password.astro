---
import ResetLinkError from '@/components/auth/ResetLinkError.vue'
import ResetPasswordForm from '@/components/auth/ResetPasswordForm.vue'
import AuthLayout from '@/layouts/Auth.astro'

// Better Auth checks the token before redirecting here and appends it as
// ?token=; a token it rejected arrives as ?error= instead. Saving the new
// password checks it once more, server-side.
const token = Astro.url.searchParams.get('token')
const linkError = Astro.url.searchParams.get('error')
---

<AuthLayout title="Neues Passwort">
  {token ? (
    <ResetPasswordForm client:load token={token} />
  ) : (
    <ResetLinkError client:load code={linkError} />
  )}
</AuthLayout>
