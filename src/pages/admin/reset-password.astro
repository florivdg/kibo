---
import ResetLinkError from '@/components/auth/ResetLinkError.vue'
import ResetPasswordForm from '@/components/auth/ResetPasswordForm.vue'
import AuthLayout from '@/layouts/Auth.astro'
import { PASSWORD_FORM_TEXTS } from '@/lib/password-form'
import { passwordFormMode } from '@/lib/password-setup'

// Better Auth checks the token before redirecting here and appends it as
// ?token=; a token it rejected arrives as ?error= instead. Saving the new
// password checks it once more, server-side. A confirmation link leads here
// too (startPasswordSetup in src/lib/auth.ts); the account's state, not the
// link, says whether this sets the first password (the reset's wording when
// that can't be read).
const token = Astro.url.searchParams.get('token')
const linkError = Astro.url.searchParams.get('error')
const mode = token ? await passwordFormMode(token) : 'reset'
---

<AuthLayout title={PASSWORD_FORM_TEXTS[mode].title}>
  {token ? (
    <ResetPasswordForm client:load token={token} mode={mode} />
  ) : (
    <ResetLinkError client:load code={linkError} />
  )}
</AuthLayout>
