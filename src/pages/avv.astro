---
import LegalLayout from '@/layouts/Legal.astro'
import { hostedContact } from '@/lib/instance'
import { serveLegalPage } from '@/lib/legal'

// The data processing agreement of the hosted instance, served like the
// imprint, in the current version (HOSTED_TERMS_VERSION); the earlier ones
// are at /avv/<version>. Without HOSTED there is no such page.
const legal = await serveLegalPage(Astro, 'avv')
if (legal instanceof Response) return legal
---

<LegalLayout page="avv" legal={legal} version={hostedContact.termsVersion} />
