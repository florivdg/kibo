---
import LegalLayout from '@/layouts/Legal.astro'
import { serveTermsVersion } from '@/lib/hosted/terms'

// The terms in the version an account agreed to, as stored when the server
// first ran with it (src/lib/hosted/terms.ts). Hosted only; an unknown
// version is an address that doesn't exist.
const version = Astro.params.version ?? ''
const legal = await serveTermsVersion(Astro, 'agb', version)
if (legal instanceof Response) return legal
---

<LegalLayout page="agb" legal={legal} version={version} />
