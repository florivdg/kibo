{
  "$schema": "./node_modules/fallow/schema.json",

  // Entry points (pages, layouts, astro.config) come from fallow's astro plugin.
  // The migration image runs migrate.mjs directly (see Dockerfile), and
  // `bun run build` bundles admin.ts to dist/admin.mjs, so nothing in the
  // project imports either. astro.config.mjs names the image service and the
  // image endpoint by their paths (image.service.entrypoint,
  // image.endpoint.entrypoint), not by an import.
  "entry": [
    "scripts/migrate.mjs",
    "scripts/admin.ts",
    "scripts/load/run.ts",
    "scripts/load/fixtures.ts",
    "tests/load/public.ts",
    "src/lib/images/image-service.ts",
    "src/lib/images/image-endpoint.ts",
  ],

  // Only imported by astro.config.mjs, which fallow treats as non-production
  // and would otherwise report as "test only" dependencies.
  "ignoreDependencies": [
    "astro",
    "@astrojs/markdown-satteri",
    "@astrojs/node",
    "@astrojs/vue",
    "@tailwindcss/vite",
  ],

  // src/components/ui is generated by shadcn-vue and must not be edited by hand.
  // Keep it in the module graph (so its imports keep deps and exports alive) but
  // hide its own findings: unused barrel re-exports, cycles, complexity, dupes.
  "ignoreFindings": ["src/components/ui/**"],
  "duplicates": {
    "ignore": ["src/components/ui/**"],
  },
  "health": {
    // global.css is the theme generated by `shadcn-vue init`; a full token
    // palette is expected to contain tokens nothing uses yet.
    "ignore": ["src/components/ui/**", "src/styles/global.css"],
    // Vue/Astro templates are measured as one synthetic unit; plain markup trips
    // the default 60-line limit on length alone.
    "thresholdOverrides": [
      {
        "files": ["src/**/*.vue", "src/**/*.astro"],
        "maxUnitSize": 150,
        "reason": "templates are markup, not logic",
      },
    ],
  },

  "audit": {
    "gate": "all",
  },
}
