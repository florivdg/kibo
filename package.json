{
  "name": "kibo",
  "type": "module",
  "version": "1.2.2",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && bun build scripts/admin.ts --target=node --packages=external --outfile=dist/admin.mjs",
    "preview": "node scripts/server.mjs",
    "admin": "bun scripts/admin.ts",
    "images": "bun scripts/responsive-images.ts",
    "astro": "astro",
    "db:up": "docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "bunx auth@latest generate --config scripts/auth-schema.ts --adapter drizzle --dialect postgresql --output src/db/schema/auth.ts --yes && prettier --write src/db/schema/auth.ts",
    "test": "bun test",
    "load:run": "bun scripts/load/run.ts",
    "load:fixtures": "bun scripts/load/fixtures.ts",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check && vue-tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run format:check && bun run test",
    "fallow": "fallow audit",
    "fallow:dead": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "^0.4.3",
    "@astrojs/node": "^11.1.7",
    "@astrojs/vue": "^7.0.3",
    "@better-auth/core": "1.7.7",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@better-auth/passkey": "1.7.7",
    "@lucide/vue": "^1.56.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^15.0.0",
    "astro": "^7.3.8",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "marked": "^18.1.1",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "reka-ui": "^2.11.0",
    "satteri": "^0.10.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "uqr": "^0.1.3",
    "vue": "^3.5.44",
    "vue-input-otp": "^0.4.0",
    "vue-sonner": "^2.0.9"
  },
  "allowScripts": {
    "esbuild": true
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "devDependencies": {
    "@simplewebauthn/server": "^13.3.3",
    "@types/bun": "^1.4.3",
    "@types/k6": "2.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "devalue": "5.9.3",
    "drizzle-kit": "^0.31.11",
    "fallow": "^3.33.1",
    "github-slugger": "^2.0.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
